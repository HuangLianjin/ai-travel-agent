SECRET_KEY=change-me-in-production
LLM_MODE=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
RATE_LIMIT_PER_MINUTE=20


# 公开内容源（默认关闭；开启后通过搜索接口发现公开攻略/景点/美食页面并抓取正文）
CONTENT_SOURCE_ENABLED=false
# CONTENT_SOURCE_DOMAINS=xiaohongshu.com,zhihu.com,jianshu.com


# 真实联网搜索（任选一个填 Key，填了就会优先走真实搜索，不再依赖爬搜索页/内置兜底）
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SERPAPI_API_KEY=
BING_SEARCH_KEY=
GOOGLE_SEARCH_KEY=
GOOGLE_CSE_ID=
SERPER_API_KEY=
BRAVE_SEARCH_KEY=


# 高德地图（可选，填了 Key 后交通路线走真实高德）
MAP_MCP_MODE=amap
MAP_MCP_API_KEY=
MAP_MCP_CITY=北京


# 天气（默认 wttr.in 免 Key；可换 QWeather/OpenWeather）
WEATHER_PROVIDER=auto
QWEATHER_API_KEY=
QWEATHER_API_HOST=
OPENWEATHER_API_KEY=

# 真实业务数据 API（可选，填了才会调用）
TICKET_API_URL=
TICKET_API_KEY=
RESTAURANT_API_URL=
RESTAURANT_API_KEY=
HOTEL_API_URL=
HOTEL_API_KEY=
TAXI_API_URL=
TAXI_API_KEY=
BIKE_API_URL=
BIKE_API_KEY=

# 酒店真实房价：Booking.com RapidAPI（个人可免费申请，填 Key 后自动走真实房价）
HOTEL_PROVIDER=booking
BOOKING_RAPIDAPI_KEY=
BOOKING_RAPIDAPI_HOST=booking-com.p.rapidapi.com

CONTENT_SOURCE_MAX_PAGES=3
