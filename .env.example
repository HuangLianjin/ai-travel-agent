SECRET_KEY=change-me-in-production
LLM_MODE=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
RATE_LIMIT_PER_MINUTE=20

# 账号安全
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
MAX_LOGIN_FAILURES=5
LOGIN_LOCK_MINUTES=15
AUTH_REGISTER_PER_HOUR=5
AUTH_LOGIN_PER_MINUTE=5
AUTH_LOGIN_PER_HOUR=10
TOTP_ISSUER=星旅 Agent

# 邮件验证（未配置 SMTP 时验证码打印到服务端日志）
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 手机号验证码（未配置短信服务商时验证码打印到服务端日志）
SMS_PROVIDER=log
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=星旅 Agent
SMS_TEMPLATE_CODE=
PHONE_REGISTER_PER_HOUR=5
PHONE_CODE_PER_MINUTE=1

# 管理员初始化：首次启动用该密码创建 super_admin，并强制首次登录改密
ADMIN_INIT_PASSWORD=
SENTRY_DSN=
SENTRY_ENV=production

# 监控告警：PushPlus（https://www.pushplus.plus 登录后复制 token，可免费微信推送）
PUSHPLUS_TOKEN=
# 企业微信机器人 Webhook（可选，可与 PushPlus 同时开启）
WECHAT_WEBHOOK=
# 演示账号：默认关闭；设为 true 才创建 demo/demo123
DEMO_SEED_ENABLED=false


# 公开内容源（默认关闭；开启后通过搜索接口发现公开攻略/景点/美食页面并抓取正文）
CONTENT_SOURCE_ENABLED=false
# CONTENT_SOURCE_DOMAINS=xiaohongshu.com,zhihu.com,jianshu.com


# 真实联网搜索（任选一个填 Key，填了就会优先走真实搜索，不再依赖爬搜索页/内置兜底）
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SERPAPI_API_KEY=
BING_SEARCH_KEY=
GOOGLE_SEARCH_KEY=
GOOGLE_CSE_ID=
SERPER_API_KEY=
BRAVE_SEARCH_KEY=


# 高德地图（可选，填了 Key 后交通路线走真实高德）
MAP_MCP_MODE=amap
MAP_MCP_API_KEY=
MAP_MCP_CITY=北京


# 天气（默认 wttr.in 免 Key；可换 QWeather/OpenWeather）
WEATHER_PROVIDER=auto
QWEATHER_API_KEY=
QWEATHER_API_HOST=
OPENWEATHER_API_KEY=

# 真实业务数据 API（可选，填了才会调用）
TICKET_API_URL=
TICKET_API_KEY=
RESTAURANT_API_URL=
RESTAURANT_API_KEY=
HOTEL_API_URL=
HOTEL_API_KEY=
TAXI_API_URL=
TAXI_API_KEY=
BIKE_API_URL=
BIKE_API_KEY=

# 酒店真实房价：Booking.com RapidAPI（个人可免费申请，填 Key 后自动走真实房价）
HOTEL_PROVIDER=booking
BOOKING_RAPIDAPI_KEY=
BOOKING_RAPIDAPI_HOST=booking-com.p.rapidapi.com

CONTENT_SOURCE_MAX_PAGES=3
